source "https://rubygems.org"

# Rails 8, API-only (CLAUDE.md). Versions are intentionally loose so the first
# `bundle install` resolves a compatible set and writes Gemfile.lock.
gem "rails", ">= 8.0", "< 9.0"
gem "pg"
gem "puma"
gem "bootsnap", require: false

# CORS for the Next.js app, and rate limiting for the family endpoint
# (CLAUDE.md rules 3 and 6). Neither is an authentication gem.
gem "rack-cors"
gem "rack-attack"

# Windows does not ship zoneinfo files.
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  gem "dotenv-rails"
  gem "factory_bot_rails"
  gem "rspec-rails"
end

group :development do
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end
