# Copy to .env for local development: cp .env.example .env
# Never commit real values. There is no secret here because Phase A has no auth.

# Database. PostgreSQL must be reachable at this host/port.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Comma-separated list of browser origins allowed by CORS (CLAUDE.md rule 3).
CORS_ORIGINS=http://localhost:3000

# Rate limiting (CLAUDE.md rule 3). Counters live in Rails.cache.
RACK_ATTACK_ENABLED=true
# Family requests per IP per minute. Polling every 10s needs 6.
RACK_ATTACK_FAMILY_LIMIT=30
# Unknown tracking codes per IP before that IP is blocked for an hour.
RACK_ATTACK_FAMILY_MISS_LIMIT=10
# Staff requests per IP per hour.
RACK_ATTACK_STAFF_LIMIT=600
STAFF_CREATION_ENABLED=true          # set false to disable new episodes

# How many days a family link stays valid once the episode is discharged.
EPISODE_LINK_TTL_DAYS=7

# Family-facing contact block on the progress page. The defaults in the code
# are demo values; set real ones for a pilot.
HOSPITAL_CONTACT_PHONE="0000 000 000"
HOSPITAL_CONTACT_TEXT="The care team can be reached through the ward."
HOSPITAL_VISITING_TEXT="Visiting is arranged with the ward. Please call before you visit."

# Words that must never appear in generated family copy (CLAUDE.md rule 4).
# Comma-separated. Leave empty to use the built-in outcome-related list.
FAMILY_BLOCKED_WORDS=
