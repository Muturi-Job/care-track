# Copy to .env on the server and replace every placeholder.
DOMAIN=caretrack.example.org
POSTGRES_PASSWORD=replace-with-a-long-random-password
RAILS_SECRET_KEY_BASE=replace-with-output-from-openssl-rand-hex-64
STAFF_AUTH_USER=caretrack-staff
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
STAFF_AUTH_PASSWORD_HASH=replace-with-caddy-bcrypt-hash

# Set false to disable staff episode creation at both the web and API layers.
STAFF_CREATION_ENABLED=true
EPISODE_LINK_TTL_DAYS=7
RACK_ATTACK_FAMILY_LIMIT=30
RACK_ATTACK_SESSION_LIMIT=20
RACK_ATTACK_FAMILY_MISS_LIMIT=10
RACK_ATTACK_STAFF_LIMIT=600
HOSPITAL_CONTACT_PHONE=0000 000 000
HOSPITAL_CONTACT_TEXT=The care team can be reached through the ward.
HOSPITAL_VISITING_TEXT=Visiting is arranged with the ward. Please call before you visit.
FAMILY_BLOCKED_WORDS=
