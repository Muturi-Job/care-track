# Copy to .env.local for local development: cp .env.example .env.local

# Server-side only: the browser never calls the API directly.
# Inside docker compose this is http://api:3001.
API_BASE_URL=http://localhost:3001

# Keep aligned with api/.env HOSPITAL_CONTACT_PHONE. This is shown as a
# tap-to-call number on the public landing page and family progress page.
HOSPITAL_CONTACT_PHONE="0000 000 000"

# Staff list and family page polling interval (CLAUDE.md rule 5).
NEXT_PUBLIC_POLL_INTERVAL_MS=10000
STAFF_CREATION_ENABLED=true
DATABASE_URL=postgres://caretrack:admin@localhost/caretrack_dev
